# Uploaded files are static images only — never execute anything here
<FilesMatch "\.(php|phtml|php\d|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
RemoveHandler .php .phtml .pl .py .cgi
RemoveType .php .phtml
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
